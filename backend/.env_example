# Picks the settings module: "prod" loads video_creator/settings/production.py (MySQL,
# DEBUG off, real SMTP, Secure cookies). Anything else, blank included, loads
# settings/local.py (SQLite, DEBUG on, email printed to the terminal).
ENV =
SECRET_KEY =

# prod only. Comma-separated hostnames; required, startup fails when left blank.
ALLOWED_HOSTS =

# Encrypts the per-user provider keys (apps/apikeysmanagement). Defaults to a value
# derived from SECRET_KEY, which is fine for dev; set it in prod and never change it
# afterwards — the stored keys cannot be read back without it. Generate one with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
FIELD_ENCRYPTION_KEY =

MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=

OPEN_API_KEY =

# Only read by the SMTP backend, which is what prod uses. Locally, mail is printed to
# the terminal instead of sent — set EMAIL_BACKEND to override that per environment.
EMAIL_BACKEND =
EMAIL_HOST_USER =
EMAIL_HOST_PASSWORD =

# Origin of the React app, used to build the password-reset link that is emailed out.
# Defaults to http://localhost:3000 in dev; in prod, set this to the real frontend
# origin (it falls back to https://<first ALLOWED_HOSTS entry> when left blank).
FRONTEND_URL =
# Path the link points at, appended to FRONTEND_URL. Defaults to /reset-password.
PASSWORD_RESET_PATH =

# Local only. Root log level, defaults to INFO; prod is always WARNING.
LOG_LEVEL =


SEARCH_ENGINE_ID =
API_KEY =



TWITCH_CLIENT =
TWITCH_CLIENT_SECRET =

XI_API_KEY =

SIXTYDB_API_KEY =

DIFFUSION_KEY =

MIDJOURNEY_KEY =

MAX_TOKENS =

# Extra budget for gpt-5/o-series thinking tokens, on top of MAX_TOKENS.
REASONING_TOKEN_ALLOWANCE =

DEFAULT_GPT_MODEL =

# Defaults to gpt-image-2 / high / 1792x1024. Change quality and size together
# with IMAGE_MODEL — they are validated per model.
IMAGE_MODEL =
IMAGE_QUALITY =
IMAGE_SIZE =

# Only used by the "sora" provider, which gives each sentence a clip instead of a
# still. Billed per second of video. Defaults to sora-2 / 1280x720.
# sora-2 accepts only 720x1280 and 1280x720; 1024x1792 and 1792x1024 need sora-2-pro.
SORA_MODEL =
SORA_SIZE =

GEMINI_API_KEY =
ANTHROPIC_API_KEY =

# Celery. Defaults to the redis-stack-server service from docker-compose.
CELERY_BROKER_URL =
CELERY_RESULT_BACKEND =
# Seconds a video may sit in GENERATION/RENDERING before it is declared dead.
VIDEO_TASK_STALE_AFTER =
