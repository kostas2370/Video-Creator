# Copy to .env.production; keep the real file private and back it up securely.
# Build each release under its Git commit and retain the previous images.
RELEASE_TAG=REPLACE_WITH_GIT_COMMIT
BACKEND_IMAGE=viddie-backend
FRONTEND_IMAGE=viddie-frontend
PRODUCTION_PROJECT_NAME=viddie-production
FRONTEND_PORT=3000

# Set the real domain when available. HTTPS terminates at a host-local proxy.
ENV=prod
ALLOWED_HOSTS=viddie.example.com
FRONTEND_URL=https://viddie.example.com
SECRET_KEY=
# A valid Fernet key (see .env_example). Preserve the existing key when migrating.
FIELD_ENCRYPTION_KEY=

POSTGRES_DB=video_creator
POSTGRES_USER=video_creator
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
# Use a URL-safe random value because it is embedded in internal Redis URLs.
REDIS_PASSWORD=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=viddie-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_JURISDICTION=eu

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Add the provider/publishing settings you use from .env_example.
GENERAL_WORKER_CONCURRENCY=2
RENDER_WORKER_CONCURRENCY=1
